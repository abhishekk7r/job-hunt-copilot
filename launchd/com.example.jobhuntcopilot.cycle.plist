<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.example.jobhuntcopilot.cycle</string>
    <key>ProgramArguments</key><array><string>/bin/bash</string><string>__REPO_ROOT__/bin/cycle.sh</string></array>
    <key>WorkingDirectory</key><string>__REPO_ROOT__</string>
    <key>StartInterval</key><integer>21600</integer>
    <key>RunAtLoad</key><false/>
    <key>StandardOutPath</key><string>__REPO_ROOT__/reports/cycle_stdout.log</string>
    <key>StandardErrorPath</key><string>__REPO_ROOT__/reports/cycle_stderr.log</string>
    <key>EnvironmentVariables</key><dict>
        <key>PATH</key><string>__HOME__/.local/bin:__HOME__/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>CYCLE_TRIGGER</key><string>launchd</string>
        <key>JOBSEARCH_CONFIG</key><string>__REPO_ROOT__/config/local.toml</string>
    </dict>
</dict>
</plist>
