<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.example.jobhuntcopilot.dashboard</string>
    <key>ProgramArguments</key><array><string>__REPO_ROOT__/.venv/bin/python</string><string>__REPO_ROOT__/harness/dashboard.py</string></array>
    <key>WorkingDirectory</key><string>__REPO_ROOT__</string>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>__REPO_ROOT__/reports/dashboard_stdout.log</string>
    <key>StandardErrorPath</key><string>__REPO_ROOT__/reports/dashboard_stderr.log</string>
    <key>EnvironmentVariables</key><dict>
        <key>HARNESS_DASH_PORT</key><string>8766</string>
        <key>PATH</key><string>/usr/bin:/bin:/usr/local/bin:/opt/homebrew/bin</string>
    </dict>
</dict>
</plist>
