#!/usr/bin/env python3
"""Kill switch CLI for Job Harness.

Usage:
  bin/killswitch status
  bin/killswitch on "<reason>"
  bin/killswitch off
"""

import os
import sys
import sqlite3
from datetime import datetime
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
DB_PATH = os.environ.get("HARNESS_DB", str(REPO_ROOT / "harness.db"))


def get_conn():
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    return conn


def status():
    conn = get_conn()
    cur = conn.cursor()
    cur.execute("SELECT \"on\", reason, ts FROM kill_switch WHERE id = 1")
    row = cur.fetchone()
    conn.close()
    if not row:
        print("Kill switch: OFF (No entry in DB)")
        return 0

    is_on = bool(row["on"])
    state = "ON (HALTED)" if is_on else "OFF (Active)"
    reason = f" - Reason: {row['reason']}" if row["reason"] else ""
    ts = f" (Updated: {row['ts']})" if row["ts"] else ""
    print(f"Kill switch: {state}{reason}{ts}")
    return 1 if is_on else 0


def set_killswitch(on_val: int, reason: str = ""):
    conn = get_conn()
    now_str = datetime.utcnow().isoformat()
    conn.execute(
        "UPDATE kill_switch SET \"on\" = ?, reason = ?, ts = ? WHERE id = 1",
        (on_val, reason, now_str)
    )
    conn.commit()
    conn.close()
    state = "ENGAGED (ON)" if on_val else "DISENGAGED (OFF)"
    print(f"Kill switch {state}: {reason}")
    return 0


def main():
    if len(sys.argv) < 2:
        return status()

    cmd = sys.argv[1].lower()
    if cmd == "status":
        return status()
    elif cmd == "on":
        reason = sys.argv[2] if len(sys.argv) > 2 else "Manual killswitch trigger via CLI"
        return set_killswitch(1, reason)
    elif cmd == "off":
        return set_killswitch(0, "")
    else:
        print(f"Unknown command: {cmd}")
        print(__doc__)
        return 2


if __name__ == "__main__":
    sys.exit(main())
